<button
  class="iconbtn"
  type="button"
  aria-label="Toggle theme"
  data-theme-toggle
>
  <span data-theme-icon>☾</span>
</button>

<style>
  .iconbtn {
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--text);
    border-radius: 999px;
    padding: 10px 12px;
    cursor: pointer;
    transition: transform 180ms ease;
  }
  .iconbtn:hover {
    transform: translateY(-1px);
  }

  :global(html.dark) .iconbtn {
    color: var(--text);
  }
</style>
